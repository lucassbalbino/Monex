{
  "name": "monex-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "web": "npm run dev --workspace=apps/web",
    "mobile": "cd apps/mobile && npx expo start",
    "mobile:android": "cd apps/mobile && npx expo run:android",
    "mobile:ios": "cd apps/mobile && npx expo run:ios",
    "shared:build": "npm run build --workspace=packages/shared"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
